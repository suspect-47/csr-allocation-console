# Copy to .env and fill. .env is gitignored. Code references these names only —
# it never reads, prints, logs, or echoes the values (spec §2).

# you.com — two distinct endpoints, two jobs (spec §1, §2). One ydc-sk-* key
# works for both. Contract confirmed against live docs (2026-07):
#   Search   GET  https://ydc-index.io/v1/search
#   Research POST https://api.you.com/v1/research
YOU_SEARCH_API_KEY=
YOU_RESEARCH_API_KEY=
YOU_SEARCH_BASE_URL=https://ydc-index.io
YOU_RESEARCH_BASE_URL=https://api.you.com

# Reasoning model — OpenAI (deviation from spec's Claude). litellm reads
# OPENAI_API_KEY; CREW_MODEL is the litellm model id (e.g. openai/gpt-4o-mini,
# openai/gpt-4o). Used by the LLM-backed Compose stage (app/clients/llm.py).
OPENAI_API_KEY=
CREW_MODEL=openai/gpt-4o-mini

# Render-provisioned. Locally these point at docker-compose services.
DATABASE_URL=postgresql://csr:csr@localhost:5432/causes
KV_URL=redis://localhost:6379/0

# Runtime
APP_ENV=development
YOUCOM_CACHE_TTL_SECONDS=21600   # 6h response cache (spec §2)
