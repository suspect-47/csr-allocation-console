# Copy to .env and fill. .env is gitignored. Code references these names only —
# it never reads, prints, logs, or echoes the values (spec §2).

# you.com — two distinct endpoints, two jobs (spec §1, §2).
# VERIFY base URLs + auth header against live docs before first live call:
#   https://docs.you.com/api-reference/search/v1-search
#   https://you.com/docs/api-reference/research/v1-research
YOU_SEARCH_API_KEY=
YOU_RESEARCH_API_KEY=
YOU_SEARCH_BASE_URL=https://api.ydc-index.io      # override once confirmed
YOU_RESEARCH_BASE_URL=https://api.ydc-index.io    # override once confirmed

# Claude — used by CrewAI llm param, per agent (spec §1). litellm reads this.
ANTHROPIC_API_KEY=
CREW_MODEL=anthropic/claude-opus-4-8

# Render-provisioned. Locally these point at docker-compose services.
DATABASE_URL=postgresql://csr:csr@localhost:5432/causes
KV_URL=redis://localhost:6379/0

# Runtime
APP_ENV=development
YOUCOM_CACHE_TTL_SECONDS=21600   # 6h response cache (spec §2)
